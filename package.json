{
  "name": "@3h4x/mcp-http-tools",
  "version": "2.1.0",
  "description": "Generic MCP-to-HTTP proxy — define tools via YAML config",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "fast-uri": "3.1.2",
      "hono": "4.12.18",
      "ip-address": "10.1.1"
    }
  },
  "main": "index.js",
  "files": [
    "index.js",
    "lib.js",
    "config.yaml",
    "README.md",
    "LICENSE",
    "docs/raw-path-placeholders.md"
  ],
  "bin": {
    "mcp-http-tools": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3h4x/mcp-http-tools.git"
  },
  "homepage": "https://github.com/3h4x/mcp-http-tools#readme",
  "bugs": {
    "url": "https://github.com/3h4x/mcp-http-tools/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "http",
    "proxy",
    "yaml",
    "tools"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node index.js",
    "test": "node --test test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "js-yaml": "^4.3.2"
  }
}
